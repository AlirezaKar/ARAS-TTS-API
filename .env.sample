# Application
APP_NAME=Persian TTS-API
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Piper models (place .onnx files under models/)
# PIPER_MODEL_PATH=models/fa_IR-amir-medium.onnx
# PIPER_LCA_MODEL_PATH=models/fa_IR-mana-medium.onnx

# ElevenLabs (premium accuracy)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Default when request omits elevenlabs_model: v1|v2|v3 (or full model_id)
# v1=eleven_flash_v2_5  v2=eleven_multilingual_v2  v3=eleven_v3
ELEVENLABS_MODEL_ID=v2

# Bale Bot (Iran-compatible) — https://dev.bale.ai
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# WhatsApp Cloud API (optional; Playwright used otherwise)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v19.0

# Playwright — use installed Edge (no CDN download; Iran-friendly)
# msedge | chrome | chromium
PLAYWRIGHT_CHANNEL=msedge
PLAYWRIGHT_HEADLESS=false

# Local audio testing without WhatsApp/Telegram/Bale send
SKIP_MESSAGING=true
