# Application
APP_NAME=Persian TTS-API
APP_HOST=0.0.0.0
APP_PORT=5004
DEBUG=false

# Direct Gemini TTS (engine=gemini) — https://ai.google.dev/gemini-api/docs/speech-generation
# Cloud Gemini-TTS overview: https://docs.cloud.google.com/text-to-speech/docs/gemini-tts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
GEMINI_PROMPT=Say the following clearly in Persian.
GEMINI_TTS_BACKEND=developer
GEMINI_LANGUAGE_CODE=fa-IR
# GOOGLE_CLOUD_PROJECT=

# Google Studio Apps Script (engine=google_studio) — key lives inside Code.gs
GOOGLE_APPS_SCRIPT_URL=

# Default output format: wav (mp3 only when requested)
DEFAULT_AUDIO_FORMAT=wav
