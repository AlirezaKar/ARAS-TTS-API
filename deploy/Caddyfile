# OPTIONAL — not used by the default Ubuntu install.
#
# The API listens directly on :5004 (see deploy/tts-api.service).
# Only use this file if you later want a reverse proxy / HTTPS in front of TTS-API
# and you have confirmed port 80/443 are free for Caddy.
#
# Example (domain + HTTPS):
#
# tts.example.com {
# 	encode gzip
# 	reverse_proxy 127.0.0.1:5004 {
# 		transport http {
# 			read_timeout 10m
# 			write_timeout 10m
# 		}
# 	}
# }
#
# Prefer binding uvicorn to 127.0.0.1 if you enable a proxy, so only Caddy is public.
